
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f7f5ef">

<title>Lord Vanne Indoc | Professional Portfolio</title>

<meta name="description" content="Professional portfolio of Lord Vanne Indoc, showcasing QA testing, administrative support, Excel, documentation, and operations projects.">

<style>
:root {
  --background: #f7f5ef;
  --surface: #ffffff;
  --navy: #172b43;
  --navy-light: #263f5b;
  --text: #263345;
  --muted: #718092;
  --accent: #9a8058;
  --accent-light: #e9e0d1;
  --border: #e5e2da;
  --max-width: 1120px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
    Roboto, Helvetica, Arial, sans-serif;
  background: var(--background);
  color: var(--text);
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  cursor: pointer;
}

.container {
  width: min(100% - 40px, var(--max-width));
  margin: 0 auto;
}

.eyebrow {
  color: var(--accent);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.section {
  padding: 100px 0;
}

.section-heading {
  max-width: 650px;
  margin-bottom: 42px;
}

.section-heading h2 {
  color: var(--navy);
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.2;
  letter-spacing: -0.045em;
  margin: 12px 0 16px;
}

.section-heading p {
  color: var(--muted);
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(247, 245, 239, 0.95);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}

.nav {
  min-height: 76px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
}

.brand {
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--navy);
  letter-spacing: -0.03em;
}

.brand span {
  color: var(--accent);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 26px;
  list-style: none;
  font-size: 0.88rem;
  color: var(--muted);
}

.nav-links a:hover {
  color: var(--navy);
}

.nav-links .nav-contact {
  background: var(--navy);
  color: white;
  padding: 10px 17px;
  border-radius: 999px;
}

.menu-button {
  display: none;
  background: none;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 12px;
  color: var(--navy);
}

.hero {
  padding: 100px 0 90px;
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  align-items: center;
  gap: 65px;
}

.hero h1 {
  color: var(--navy);
  font-size: clamp(2.8rem, 6vw, 5rem);
  line-height: 1.04;
  letter-spacing: -0.065em;
  margin: 22px 0;
}

.hero h1 em {
  color: var(--accent);
  font-style: normal;
}

.hero-description {
  color: var(--muted);
  font-size: 1.08rem;
  max-width: 590px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
  margin-top: 32px;
}

.button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  border: 1px solid var(--navy);
  border-radius: 999px;
  padding: 13px 23px;
  font-weight: 700;
  font-size: 0.9rem;
  transition: transform 0.2s, background 0.2s;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  color: white;
  background: var(--navy);
}

.button-primary:hover {
  background: var(--navy-light);
}

.button-secondary {
  color: var(--navy);
  background: transparent;
}

.hero-card {
  background: var(--navy);
  color: white;
  padding: 35px;
  border-radius: 26px;
  position: relative;
  box-shadow: 0 24px 60px rgba(23, 43, 67, 0.12);
}

.hero-card-label {
  color: #c7b99f;
  text-transform: uppercase;
  letter-spacing: 0.13em;
  font-size: 0.72rem;
  font-weight: 800;
}

.hero-card h3 {
  font-size: 1.7rem;
  line-height: 1.3;
  margin: 18px 0;
}

.hero-card p {
  color: #c5cfda;
  font-size: 0.93rem;
}

.skill-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 26px;
}

.skill-pills span {
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 0.78rem;
  color: #e1e6ec;
}

.expertise-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.expertise-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 28px;
  transition: transform 0.2s, box-shadow 0.2s;
}

.expertise-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 15px 35px rgba(23, 43, 67, 0.06);
}

.expertise-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  background: var(--accent-light);
  color: var(--navy);
  border-radius: 13px;
  font-size: 1.25rem;
  margin-bottom: 20px;
}

.expertise-card h3 {
  color: var(--navy);
  font-size: 1.12rem;
  margin-bottom: 10px;
}

.expertise-card p {
  color: var(--muted);
  font-size: 0.91rem;
}

.projects-section {
  background: #eeece5;
}

.project-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 30px;
}

.filter-button {
  background: transparent;
  border: 1px solid #d8d5cc;
  color: var(--muted);
  border-radius: 999px;
  padding: 9px 17px;
  font-size: 0.85rem;
}

.filter-button.active,
.filter-button:hover {
  background: var(--navy);
  color: white;
  border-color: var(--navy);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
}

.project-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}

.project-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 40px rgba(23, 43, 67, 0.07);
}

.project-visual {
  min-height: 190px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25px;
  background: #e9e5dc;
}

.project-visual.navy {
  background: #1c3048;
}

.project-visual.green {
  background: #e3e8df;
}

.project-visual.gold {
  background: #eee4d3;
}

.visual-window {
  width: 100%;
  max-width: 330px;
  background: white;
  border: 1px solid #d9dce0;
  border-radius: 12px;
  padding: 15px;
  box-shadow: 0 12px 25px rgba(0,0,0,0.08);
}

.window-top {
  display: flex;
  gap: 5px;
  margin-bottom: 14px;
}

.window-top span {
  width: 7px;
  height: 7px;
  background: #c8cbd0;
  border-radius: 50%;
}

.mock-line {
  height: 8px;
  background: #e8ebef;
  border-radius: 4px;
  margin: 9px 0;
}

.mock-line.short {
  width: 48%;
}

.mock-line.medium {
  width: 72%;
}

.mock-line.accent {
  background: #d8c7a8;
  width: 35%;
}

.mock-table {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 5px;
  margin-top: 12px;
}

.mock-table span {
  height: 22px;
  background: #eef0f2;
  border-radius: 3px;
}

.mock-table span:first-child,
.mock-table span:nth-child(2),
.mock-table span:nth-child(3) {
  background: #dbe5dc;
}

.project-content {
  padding: 27px;
}

.project-category {
  color: var(--accent);
  font-size: 0.73rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.project-content h3 {
  color: var(--navy);
  font-size: 1.3rem;
  margin: 10px 0;
}

.project-content p {
  color: var(--muted);
  font-size: 0.92rem;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0;
}

.project-tags span {
  background: #f2f1ed;
  color: #586575;
  border-radius: 6px;
  padding: 5px 9px;
  font-size: 0.75rem;
}

.project-link {
  color: var(--navy);
  font-weight: 750;
  font-size: 0.88rem;
  border-bottom: 1px solid var(--accent);
  padding-bottom: 3px;
}

.about-grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 70px;
  align-items: start;
}

.about-highlight {
  background: var(--navy);
  color: white;
  padding: 34px;
  border-radius: 22px;
}

.about-highlight .eyebrow {
  color: #c8b89a;
}

.about-highlight h3 {
  font-size: 1.7rem;
  line-height: 1.3;
  margin: 15px 0;
}

.about-highlight p {
  color: #c5cfda;
  font-size: 0.94rem;
}

.about-text h2 {
  color: var(--navy);
  font-size: clamp(2rem, 4vw, 2.8rem);
  line-height: 1.2;
  letter-spacing: -0.05em;
  margin: 12px 0 22px;
}

.about-text p {
  color: var(--muted);
  margin-bottom: 16px;
}

.skills-list {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 24px;
}

.skills-list span {
  background: white;
  border: 1px solid var(--border);
  color: var(--navy);
  border-radius: 999px;
  padding: 8px 13px;
  font-size: 0.82rem;
}

.experience-section {
  background: #eeece5;
}

.timeline {
  max-width: 800px;
  border-left: 1px solid #d5d1c7;
  margin-left: 10px;
}

.timeline-item {
  position: relative;
  padding: 0 0 35px 30px;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: -6px;
  top: 9px;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--accent);
  border: 2px solid #eeece5;
}

.timeline-item h3 {
  color: var(--navy);
  font-size: 1.12rem;
}

.timeline-item .date {
  color: var(--accent);
  font-size: 0.82rem;
  font-weight: 750;
  margin: 4px 0 8px;
}

.timeline-item p {
  color: var(--muted);
  font-size: 0.92rem;
}

.contact-section {
  padding: 100px 0;
}

.contact-card {
  background: var(--navy);
  color: white;
  border-radius: 28px;
  padding: 60px;
  text-align: center;
}

.contact-card .eyebrow {
  color: #c8b89a;
}

.contact-card h2 {
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.2;
  letter-spacing: -0.05em;
  margin: 15px 0;
}

.contact-card p {
  color: #c5cfda;
  max-width: 560px;
  margin: 0 auto 28px;
}

.contact-card .button {
  background: white;
  color: var(--navy);
  border-color: white;
}

.footer {
  padding: 25px 0;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.82rem;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

@media (max-width: 850px) {
  .hero-grid,
  .about-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .hero {
    padding: 70px 0;
  }

  .expertise-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 650px) {
  .container {
    width: min(100% - 30px, var(--max-width));
  }

  .section {
    padding: 70px 0;
  }

  .nav {
    min-height: 68px;
  }

  .menu-button {
    display: block;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 68px;
    left: 0;
    right: 0;
    background: var(--background);
    border-bottom: 1px solid var(--border);
    padding: 20px;
    flex-direction: column;
    align-items: stretch;
    gap: 15px;
  }

  .nav-links.open {
    display: flex;
  }

  .nav-links .nav-contact {
    text-align: center;
  }

  .hero {
    padding: 60px 0;
  }

  .hero h1 {
    font-size: clamp(2.7rem, 12vw, 4rem);
  }

  .hero-card {
    padding: 27px;
  }

  .expertise-grid,
  .projects-grid {
    grid-template-columns: 1fr;
  }

  .project-visual {
    min-height: 170px;
  }

  .contact-card {
    padding: 40px 25px;
  }

  .footer-inner {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
  }
}
</style>
</head>

